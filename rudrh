public function onCommand(CommandSender $sender, Command $command, string $label, array $args): bool {
    if ($command->getName() === "경고") {
        if (count($args) < 2) {
            $sender->sendMessage("사용법: /경고 <플레이어> <사유>");
            return true;
        }

        $targetName = array_shift($args);
        $reason = implode(" ", $args);
        $target = $this->getServer()->getPlayerExact($targetName);

        if ($target === null) {
            $sender->sendMessage("플레이어를 찾을 수 없습니다.");
            return true;
        }

        $name = strtolower($target->getName());
        $this->warnings[$name][] = $reason;

        $target->sendMessage("⚠️ 당신은 경고를 받았습니다: $reason");
        $sender->sendMessage("✅ {$target->getName()}에게 경고를 주었습니다.");

        if (count($this->warnings[$name]) >= 5) {
            $target->kick("경고 5회 누적 - 서버에서 퇴장 처리되었습니다.", false);
            $sender->sendMessage("🚫 {$target->getName()}는 경고 5회로 퇴장당했습니다.");
        }
        return true;
    }

    return false;
}
